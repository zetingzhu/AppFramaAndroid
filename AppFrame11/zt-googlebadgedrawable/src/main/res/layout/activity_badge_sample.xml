<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BadgeDrawable Usage Sample"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. Arbitrary View with Badge -->
    <TextView
        android:id="@+id/label1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="1. Arbitrary View (BadgeUtils)"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <FrameLayout
        android:id="@+id/badge_anchor_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label1">

        <ImageView
            android:id="@+id/iv_anchor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Mail icon"
            android:src="@android:drawable/ic_dialog_email" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/badge_anchor_container_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@+id/badge_anchor_container"
        app:layout_constraintTop_toBottomOf="@id/label1">

        <ImageView
            android:id="@+id/iv_anchor_2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Mail icon"
            android:src="@android:drawable/ic_dialog_email" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/badge_anchor_container_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@+id/badge_anchor_container_2"
        app:layout_constraintTop_toBottomOf="@id/label1">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Mail icon"
            android:src="@android:drawable/ic_dialog_email" />
    </FrameLayout>

    <Button
        android:id="@+id/btn_update_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Increment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/badge_anchor_container" />

    <!-- 2. TabLayout with Badge -->
    <TextView
        android:id="@+id/label2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="2. TabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_update_badge" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/label2">

        <com.google.android.material.tabs.TabItem android:text="Home" />

        <com.google.android.material.tabs.TabItem android:text="Status" />

        <com.google.android.material.tabs.TabItem android:text="Calls" />
    </com.google.android.material.tabs.TabLayout>

    <!-- 3. BottomNavigationView with Badge -->
    <TextView
        android:id="@+id/label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="3. BottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/label3"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header Blue Gradient Area -->
        <View
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:background="@drawable/bg_submit_header_gradient"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Yellow Glow Top Right -->
        <View
            android:id="@+id/yellow_glow"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="-20dp"
            android:background="@drawable/bg_yellow_glow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Decorative blur circle image 48 (bg_blur_circle.png) -->
        <ImageView
            android:id="@+id/bg_blur_circle"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginStart="-20dp"
            android:layout_marginTop="250dp"
            android:src="@drawable/bg_blur_circle"
            android:alpha="0.65"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription" />

        <!-- Back Bar -->
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="45dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_back_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="ContentDescription" />

        <!-- Success Icon (Group 66) -->
        <ImageView
            android:id="@+id/iv_success_icon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="109dp"
            android:src="@drawable/ic_success"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="ContentDescription" />

        <!-- Success Text -->
        <TextView
            android:id="@+id/tv_success_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enviado con éxito"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/iv_success_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Loan Details Title -->
        <TextView
            android:id="@+id/tv_details_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="24dp"
            android:text="Plazo del préstamo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_success_title"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Glassmorphism Loan Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_loan_details"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:padding="20dp"
            android:background="@drawable/bg_glass_card"
            app:layout_constraintTop_toBottomOf="@id/tv_details_title">

            <!-- Row 1: Monto solicitado -->
            <TextView
                android:id="@+id/lbl_monto_solicitado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monto solicitado"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/val_monto_solicitado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/10,000.00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 2: Importe real recibido -->
            <TextView
                android:id="@+id/lbl_importe_recibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Importe real recibido"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toBottomOf="@id/lbl_monto_solicitado"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/val_importe_recibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/8,000.00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/lbl_importe_recibido"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 3: Monto a pagar -->
            <TextView
                android:id="@+id/lbl_monto_pagar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Monto a pagar"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toBottomOf="@id/lbl_importe_recibido"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/val_monto_pagar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/10,000.00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/lbl_monto_pagar"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 4: Fecha de pago -->
            <TextView
                android:id="@+id/lbl_fecha_pago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Fecha de pago"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toBottomOf="@id/lbl_monto_pagar"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/val_fecha_pago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30/01/2026"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/lbl_fecha_pago"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Recommended Activities Title -->
        <TextView
            android:id="@+id/tv_recommended_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:text="Más actividades recomendadas"
            android:textColor="#141A36"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/header_bg"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Activity Banner Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_banner"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_recommended_title">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Banner Background Image -->
                <ImageView
                    android:id="@+id/iv_banner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_banner_fraud_7c5052"
                    tools:ignore="ContentDescription" />

                <!-- Text 1: Para Prevenir El Fraude -->
                <TextView
                    android:id="@+id/tv_banner_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="28dp"
                    android:text="Para Prevenir El Fraude"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:shadowColor="#59000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Text 2: ¡Recordatorio especial -->
                <TextView
                    android:id="@+id/tv_banner_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="¡Recordatorio especial "
                    android:textColor="#FFFFFF"
                    android:alpha="0.65"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/tv_banner_header"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Entendido Button -->
        <FrameLayout
            android:id="@+id/btn_understood"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_btn_understood"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/card_banner"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Entendido"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

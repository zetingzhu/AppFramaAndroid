<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppFrame11">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppFrame11">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DeviceInfoActivity"
            android:exported="false"
            android:label="@string/device_info_title"
            android:theme="@style/Theme.AppFrame11" />
        <activity
            android:name=".DeviceRecallTestActivity"
            android:exported="false"
            android:label="@string/device_recall_title"
            android:theme="@style/Theme.AppFrame11" />
        <activity
            android:name=".IntegrityRemediationActivity"
            android:exported="false"
            android:label="@string/integrity_remediation_title"
            android:theme="@style/Theme.AppFrame11" />
        <activity
            android:name=".KeyAttestationActivity"
            android:exported="false"
            android:label="@string/key_attestation_title"
            android:theme="@style/Theme.AppFrame11" />
        <activity
            android:name=".DeviceAttestManagerActivity"
            android:exported="false"
            android:label="@string/device_attest_manager_title"
            android:theme="@style/Theme.AppFrame11" />
        <activity
            android:name=".DownloadQuestionnaireActivity"
            android:exported="false"
            android:label="@string/download_questionnaire_title"
            android:theme="@style/Theme.AppFrame11" />
    </application>

</manifest>
